# Como o app fala com o Claude:
#   claude-code = usa o Claude Code instalado no PC com o login da sua assinatura (Pro/Max).
#                 Sem custo extra, mas consome a cota de uso da assinatura.
#   api         = usa a API da Anthropic (cobrança por uso). Preencha ANTHROPIC_API_KEY.
CLAUDE_BACKEND=claude-code

# Caminho do executável do Claude Code (só se não estiver no PATH)
# CLAUDE_CODE_PATH=C:/Users/SEU_USUARIO/.local/bin/claude.exe

# Só para CLAUDE_BACKEND=api (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo e esforço de raciocínio usados para escolher e editar os cortes.
# Para poupar a cota: CLAUDE_MODEL=claude-sonnet-5-5 e/ou CLAUDE_EFFORT=medium
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Transcrição local (faster-whisper): tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Opcional: onde ficam vídeos e clipes. Padrão no Windows: %LOCALAPPDATA%\cortevideos\data
# Evite pastas do OneDrive/Google Drive.
# DATA_DIR=D:/cortevideos-data

# Opcional: arquivo de cookies (formato Netscape) se o YouTube bloquear o download
# YTDLP_COOKIES_FILE=C:/caminho/cookies.txt

# Opcional: usar outro ffmpeg em vez do embutido
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
